.gradle
/build
build/
/captures
.externalNativeBuild
.cxx
local.properties
/llama.cpp
.kotlin
.artifacts/
.DS_Store

# ---- Android Studio: keep only shared code style and inspection profiles ----
.idea/*
!.idea/codeStyles/
!.idea/inspectionProfiles/

# ---- Large model binaries (exceed the GitHub push limit; see scripts/fetch_models.sh) ----
app/src/main/assets/models/*.gguf
app/src/main/assets/models/clip/*.tflite
app/src/debug/assets/models/clip/*.tflite
clip_model/src/main/assets/models/clip/*.tflite
*.apks
tools/bundletool/

# ---- Logs, caches, virtualenvs ----
*.log
crash_log.txt
eval/parity/.venv/
__pycache__/
*.pyc

# ---- Personal data: never commit device databases, queries or raw benchmark exports ----
*.db
*.db-shm
*.db-wal
queries*.csv
sample_targets*.csv
eval/evidence/
