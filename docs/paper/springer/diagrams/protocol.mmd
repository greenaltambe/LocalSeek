flowchart TB
    subgraph r0[" "]
        direction LR
        reg["Plan registered on OSF<br/>(vwmfz) before any run"]
        q["95 real-use queries<br/>(75 name-like,<br/>20 sentence-like)"]
        run["9 configurations x 5 runs<br/>4,275 searches on the phone"]
        reg --> q --> run
    end
    subgraph r1[" "]
        direction RL
        pool["Depth-10 pool of all arms<br/>1,442 results"]
        judge["Blind relevance judging<br/>(arm hidden): 197 relevant"]
        excl["Exclusions as registered<br/>77 scored queries, 64 clusters"]
        pool --> judge --> excl
    end
    run --> pool
    subgraph r2[" "]
        direction LR
        ana["Cluster-level analysis:<br/>randomisation test, bootstrap<br/>95% CI, Holm over H1-H5"]
        resu["H1-H5 (confirmatory)<br/>+ exploratory contrasts"]
        ana --> resu
    end
    excl --> ana
    style r0 fill:none,stroke:none
    style r1 fill:none,stroke:none
    style r2 fill:none,stroke:none
    class reg plan
    class q input
    class run core
    class pool,judge,excl data
    class ana,resu result
    classDef input fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000
    classDef core fill:#E6E6E6,stroke:#000000,stroke-width:1px,color:#000
    classDef result fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000
    classDef data fill:#F2F2F2,stroke:#000000,stroke-width:1px,color:#000
    classDef plan fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000
    classDef plain fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000
    classDef opt fill:#FFFFFF,stroke:#555555,stroke-width:1px,stroke-dasharray:5 4,color:#333
