flowchart TB
    subgraph IDX["Indexing (background, on the phone)"]
        direction TB
        files["Files<br/>(PDF, text)"]
        apps["Installed apps"]
        contacts["Contacts"]
        images["Images<br/>(optional)"]
        prep["Text extraction and chunking<br/>files: 150-word chunks,<br/>40-word overlap;<br/>apps, contacts: names, labels"]
        fts["SQLite FTS5 tables<br/>(chunks, apps, contacts)"]
        emb["MiniLM embeddings<br/>(384-d, TensorFlow Lite)"]
        clip["CLIP image<br/>embeddings"]
        files --> prep
        apps --> prep
        contacts --> prep
        prep --> fts
        prep --> emb
        images --> clip
    end
    subgraph SRCH["Search (per query, on the phone)"]
        direction TB
        qp["User query: normalised,<br/>stop words removed"]
        bm25["BM25 over 3 FTS5 tables<br/>rank-merged (RRF)"]
        dense["Dense search<br/>exact up to 25k chunks,<br/>binary shortlist above"]
        img["Image search<br/>(CLIP, optional)"]
        rrf["Reciprocal-rank fusion (k = 60)"]
        rerank["Optional cross-encoder rerank<br/>of the top 20 (off by default)"]
        res["Ranked results"]
        qp --> bm25
        qp --> dense
        qp --> img
        bm25 --> rrf
        dense --> rrf
        img --> rrf
        rrf --> rerank
        rerank --> res
    end
    IDX -. "indexes read at query time" .-> SRCH
    class files,apps,contacts,res input
    class prep,fts,emb data
    class qp plain
    class bm25,dense core
    class rrf result
    class images,clip,img,rerank opt
    classDef input fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000
    classDef core fill:#FFFFFF,stroke:#000000,stroke-width:1.6px,color:#000
    classDef result fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000
    classDef data fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000
    classDef plan fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000
    classDef plain fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000
    classDef opt fill:#FFFFFF,stroke:#555555,stroke-width:1px,stroke-dasharray:5 4,color:#333
