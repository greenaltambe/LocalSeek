flowchart TB
    app["<b>LocalSeek app</b><br/>hybrid BM25 + dense search"]
    subgraph S1["Study 1: quality on real phones"]
        direction LR
        s1a["<b>1A: owner's phone</b><br/>(confirmatory, OSF)<br/>95 queries,<br/>9 configurations"]
        s1b["<b>1B: users' phones</b><br/>(exploratory)<br/>11 volunteers,<br/>blind judging"]
    end
    s2["<b>Study 2: speed and cost</b><br/>(descriptive)<br/>2 test phones,<br/>10k to 200k vectors;<br/>11 users' phones"]
    s3["<b>Study 3: public data</b><br/>(exploratory)<br/>Python port,<br/>5 BEIR datasets,<br/>5 embedding models"]
    out["<b>Shipped in v1.0.0</b><br/>hybrid RRF, exact dense search<br/>(binary shortlist above 25k chunks),<br/>no reranker"]
    app --> S1
    app --> s2
    app --> s3
    S1 --> out
    s2 --> out
    s3 --> out
    class app,out data
    class s1a,s1b input
    class s2 core
    class s3 result
    classDef input fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000
    classDef core fill:#E6E6E6,stroke:#000000,stroke-width:1px,color:#000
    classDef result fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000
    classDef data fill:#F2F2F2,stroke:#000000,stroke-width:1px,color:#000
    classDef plan fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000
    classDef plain fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000
    classDef opt fill:#FFFFFF,stroke:#555555,stroke-width:1px,stroke-dasharray:5 4,color:#333
