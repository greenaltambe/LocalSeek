<?xml version="1.0" encoding="utf-8"?>
<!--
  LocalSeek indexes personal files, contacts and app lists on-device. None of that
  (database, prefs, API keys) may leave the device via backup. Backup is also
  disabled via android:allowBackup="false"; these rules are defence in depth.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
