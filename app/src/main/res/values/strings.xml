    <string name="onboarding_welcome_title">Search your phone, privately</string>
    <string name="onboarding_welcome_body">Find apps, contacts, documents and photos from one search bar.</string>
    <string name="onboarding_welcome_b1">Indexing and searching happen entirely on this device.</string>
    <string name="onboarding_welcome_b2">LocalSeek has no internet permission, so it cannot send anything off your phone.</string>
    <string name="onboarding_welcome_b3">Web search buttons simply open your browser; LocalSeek itself never connects.</string>
    <string name="onboarding_what_title">What you can search</string>
    <string name="onboarding_what_body">Type a few words. Results are grouped by type.</string>
    <string name="onboarding_what_apps">Apps: launch anything installed.</string>
    <string name="onboarding_what_contacts">Contacts: find people, then call or message.</string>
    <string name="onboarding_what_files">Files: PDFs and plain-text files (notes, markdown, csv, json, code) in Documents and Download, by meaning as well as keywords.</string>
    <string name="onboarding_what_images">Images: describe a photo in words (optional).</string>
    <string name="onboarding_perm_step">Permission %1$d of %2$d</string>
    <string name="onboarding_perm_optional">Optional. LocalSeek still works without it, and you can change this any time in system settings.</string>
    <string name="onboarding_perm_allow">Allow</string>
    <string name="onboarding_perm_not_now">Not now</string>
    <string name="onboarding_perm_granted">Allowed</string>
    <string name="onboarding_perm_contacts_title">Find your contacts</string>
    <string name="onboarding_perm_contacts_why">With contact access LocalSeek can find people by name and offer call and message buttons. Contact details stay on this device.</string>
    <string name="onboarding_perm_files_title">Search your documents</string>
    <string name="onboarding_perm_files_why">All-files access lets LocalSeek read documents in Documents and Download so they can be searched. Android opens a special settings screen for this. Nothing is uploaded.</string>
    <string name="onboarding_perm_photos_title">Search your photos</string>
    <string name="onboarding_perm_photos_why">Photo access lets image search find pictures by description. Photos are analysed on this device only.</string>
    <string name="onboarding_pack_title">Image search pack</string>
    <string name="onboarding_pack_body">Searching photos by description needs an optional %1$d MB model pack.</string>
    <string name="onboarding_pack_wifi">Google Play downloads the pack on demand. A Wi-Fi connection is recommended.</string>
