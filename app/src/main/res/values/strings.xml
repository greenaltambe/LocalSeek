    <!-- About -->
    <string name="about_title">About, privacy and licenses</string>
    <string name="about_subtitle">Version, privacy summary, open-source licenses</string>
    <string name="about_version">Version %1$s (%2$d)</string>
    <string name="about_build">Build %s</string>
    <string name="about_tagline">On-device search for your apps, contacts, files and photos.</string>
    <string name="about_no_internet_title">No internet permission</string>
    <string name="about_no_internet_body">LocalSeek does not request the INTERNET permission, so Android does not allow it to connect to any network. You can verify this yourself: open the app info page below and look at Permissions.</string>
    <string name="about_open_app_info">Open system app info</string>
    <string name="about_privacy_title">Privacy summary</string>
    <string name="about_privacy_1">With your permission LocalSeek reads files, contacts, installed apps and images on this device to build a search index.</string>
    <string name="about_privacy_2">The index stays in the app’s private storage. Nothing is sent anywhere.</string>
    <string name="about_privacy_3">No analytics, advertising or crash-reporting SDKs are included.</string>
    <string name="about_privacy_4">Cloud backup and device-to-device transfer are disabled for this app.</string>
    <string name="about_privacy_5">Deny or revoke any permission in Android settings. Clearing app storage or uninstalling deletes everything.</string>
